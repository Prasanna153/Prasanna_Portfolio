# Copy this file to ".env" and fill in your own values.
# Never share the .env file or upload it to GitHub.

# Admin login for /admin (used to add / remove certificates)
ADMIN_USERNAME=prasanna
ADMIN_PASSWORD=change-this-to-a-long-password

# Any long random text. Used to sign the admin login token.
JWT_SECRET=paste-a-long-random-string-here

# Port the server listens on (hosting platforms set this automatically)
PORT=3001

# Folder where certificate images + messages are stored.
# On a hosting service, point this at a persistent disk / volume, e.g. /var/data
# DATA_DIR=./data
